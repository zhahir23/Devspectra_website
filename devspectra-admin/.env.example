# Salin file ini menjadi ".env", lalu sesuaikan isinya.
# Semua variabel VITE_ ikut terkirim ke browser, jadi JANGAN taruh password
# database, kunci JWT, atau rahasia lain di sini.

# Alamat backend Spring Boot (lihat server.port di application.properties).
VITE_API_URL=http://localhost:8081

# Alamat website company (website-devspectra-new, Next.js), untuk menampilkan gambar
# project yang masih tersimpan di folder public website (Konten website > Projects).
# Login ada di dashboard ini sendiri, jadi alamat ini tidak dipakai untuk login.
VITE_WEBSITE_URL=http://localhost:3000

# Nama kunci token login di localStorage.
VITE_TOKEN_KEY=token

# Email dua pemegang keuangan, dipisah koma. Hanya mereka yang bisa membuka Keuangan,
# menambah anggota, dan menghapus anggota. Anggota lain hanya bisa mengubah data dan
# password akunnya sendiri. Backend juga harus memakai daftar yang sama
# (environment variable FINANCE_EMAILS, lihat CATATAN-BACKEND.md bagian 5).
VITE_FINANCE_EMAILS=nama1@devspectra.com,nama2@devspectra.com

# true  = pakai data contoh, tanpa backend (untuk mencoba tampilan)
# false = tersambung ke backend sungguhan
VITE_DEMO_MODE=false
